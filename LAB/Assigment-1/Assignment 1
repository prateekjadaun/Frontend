<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prateek Jadaun | Portfolio</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            color: #222;
            scroll-behavior: smooth;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        ul {
            list-style: none;
        }

        .navbar {
            background: #0d1b4c;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 40px;
        }

        .logo h1 {
            font-size: 22px;
        }

        .logo p {
            font-size: 13px;
            color: #cfd8f7;
        }

        .nav-links {
            display: flex;
            gap: 25px;
        }

        .nav-links a {
            font-size: 15px;
        }

        .nav-links a:hover,
        .nav-links .active {
            color: #ffcc00;
        }

        .hero {
            background: #dbe9fb;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 60px;
            gap: 30px;
        }

        .hero-text {
            max-width: 550px;
        }

        .hero-text h2 {
            font-size: 36px;
            color: #0d1b4c;
        }

        .hero-text h3 {
            color: #1e5fd9;
            margin-bottom: 15px;
        }

        .hero-text p {
            margin-bottom: 25px;
            line-height: 1.6;
        }

        .btn-primary,
        .btn-secondary {
            padding: 10px 22px;
            border: none;
            border-radius: 4px;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-primary {
            background: #0d1b4c;
            color: white;
        }

        .btn-secondary {
            background: #e0e0e0;
        }

        .hero-image img {
            width: 260px;
            height: 260px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid white;
        }

        .info-section,
        .bottom-section {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            padding: 50px 60px;
        }

        .info-box {
            flex: 1;
            min-width: 250px;
        }

        .info-box h3,
        .bottom-left h3,
        .bottom-right h3 {
            color: #0d1b4c;
            margin-bottom: 15px;
        }

        .info-box h3 i,
        .bottom-left h3 i,
        .bottom-right h3 i {
            color: #1e5fd9;
            margin-right: 8px;
        }

        .info-box p {
            line-height: 1.6;
        }

        .skills-list li {
            margin-bottom: 8px;
        }

        .skills-list li::before {
            content: "• ";
            color: #1e5fd9;
        }

        .education-box {
            flex: 2;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: left;
        }

        th {
            background: #f5f7fb;
        }

        .bottom-section {
            gap: 40px;
            padding-top: 20px;
        }

        .bottom-left {
            flex: 2;
        }

        .bottom-right {
            flex: 1;
        }

        .projects-container {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 30px;
        }

        .project-card {
            flex: 1;
            min-width: 200px;
            border: 1px solid #ddd;
            border-radius: 6px;
            padding: 18px;
        }

        .project-card h4 {
            color: #0d1b4c;
            margin-bottom: 8px;
        }

        .project-card p {
            font-size: 13px;
            line-height: 1.5;
            margin-bottom: 12px;
        }

        .project-card a {
            color: #1e5fd9;
            font-weight: 600;
        }

        .social-links {
            display: flex;
            gap: 15px;
        }

        .social-links a {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #f0f0f0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #0d1b4c;
        }

        #contactForm label {
            display: block;
            margin: 12px 0 5px;
            font-weight: 600;
        }

        #contactForm input,
        #contactForm textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        .form-buttons {
            display: flex;
            gap: 12px;
            margin-top: 18px;
        }

        #formStatus {
            margin-top: 12px;
            color: green;
        }

        footer {
            background: #0d1b4c;
            color: white;
            text-align: center;
            padding: 18px;
        }

        @media (max-width: 768px) {
            .navbar,
            .hero {
                flex-direction: column;
                text-align: center;
            }

            .nav-links {
                flex-wrap: wrap;
                justify-content: center;
                margin-top: 10px;
            }

            .hero {
                padding: 40px 20px;
            }

            .info-section,
            .bottom-section {
                padding: 30px 20px;
            }
        }
    </style>
</head>

<body>

<header class="navbar">
    <div class="logo">
        <h1>Prateek Jadaun</h1>
        <p>Computer Science & Engineering Student</p>
    </div>

    <nav>
        <ul class="nav-links">
            <li><a href="#home" class="active">Home</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#skills">Skills</a></li>
            <li><a href="#education">Education</a></li>
            <li><a href="#projects">Projects</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>
</header>

<section id="home" class="hero">

    <div class="hero-text">
        <h2>Hi, I'm Prateek Jadaun</h2>
        <h3>CSE Student</h3>

        <p>
            I am a Computer Science and Engineering student at GLA University.
            I am interested in web development, cloud computing and learning
            new technologies.
        </p>

        <a href="mailto:prateekjadaun2008@gmail.com" class="btn-primary">
            Contact Me
        </a>
    </div>

    <div class="hero-image">
        <img src="https://i.pravatar.cc/300?img=12" alt="Prateek Jadaun">
    </div>

</section>

<section class="info-section">

    <div id="about" class="info-box">
        <h3><i class="fa-solid fa-user"></i> About Me</h3>

        <p>
            I am a B.Tech Computer Science and Engineering student at
            GLA University. I enjoy solving problems and developing
            useful web applications. My goal is to improve my technical
            skills and work on real-world projects.
        </p>
    </div>

    <div id="skills" class="info-box">
        <h3><i class="fa-solid fa-code"></i> Skills</h3>

        <ul class="skills-list">
            <li>HTML</li>
            <li>CSS</li>
            <li>JavaScript</li>
            <li>Bootstrap</li>
            <li>Java</li>
            <li>Cloud Computing</li>
            <li>Git & GitHub</li>
        </ul>
    </div>

    <div id="education" class="info-box education-box">

        <h3>
            <i class="fa-solid fa-graduation-cap"></i>
            Education
        </h3>

        <table>
            <tr>
                <th>Qualification</th>
                <th>Institute</th>
                <th>Year</th>
                <th>Score</th>
            </tr>

            <tr>
                <td>B.Tech CSE</td>
                <td>GLA University</td>
                <td>2029</td>
                <td>7.96 CGPA</td>
            </tr>

            <tr>
                <td>12th</td>
                <td>Raj Kamal Public School</td>
                <td>2025</td>
                <td>85.4%</td>
            </tr>

            <tr>
                <td>10th</td>
                <td>Raj Kamal Public School</td>
                <td>2023</td>
                <td>81.4%</td>
            </tr>
        </table>

    </div>

</section>

<section class="bottom-section">

    <div class="bottom-left">

        <h3 id="projects">
            <i class="fa-solid fa-briefcase"></i>
            Projects
        </h3>

        <div class="projects-container">

            <div class="project-card">
                <h4>Online Examination Portal</h4>

                <p>
                    A web-based examination portal that allows students
                    to attend online tests and manage examinations easily.
                </p>

                <a href="#">View Project</a>
            </div>

            <div class="project-card">
                <h4>Portfolio Website</h4>

                <p>
                    A personal portfolio website created using HTML,
                    CSS and JavaScript.
                </p>

                <a href="#">View Project</a>
            </div>

        </div>

        <h3>
            <i class="fa-solid fa-link"></i>
            Connect with me
        </h3>

        <div class="social-links">

            <a href="https://www.linkedin.com/in/prateek-jadaun-664b2137b"
               target="_blank">
                <i class="fa-brands fa-linkedin"></i>
            </a>

            <a href="https://github.com/prateekjadaun"
               target="_blank">
                <i class="fa-brands fa-github"></i>
            </a>

            <a href="mailto:prateekjadaun2008@gmail.com">
                <i class="fa-solid fa-envelope"></i>
            </a>

            <a href="tel:+919528193361">
                <i class="fa-solid fa-phone"></i>
            </a>

        </div>

    </div>

    <div id="contact" class="bottom-right">

        <h3>
            <i class="fa-solid fa-envelope"></i>
            Contact Me
        </h3>

        <form id="contactForm">

            <label>Name</label>
            <input type="text" id="name"
                   placeholder="Enter your name" required>

            <label>Email</label>
            <input type="email"
                   placeholder="Enter your email" required>

            <label>Message</label>
            <textarea rows="4"
                      placeholder="Type your message..."
                      required></textarea>

            <div class="form-buttons">
                <button type="submit" class="btn-primary">
                    Send Message
                </button>

                <button type="reset" class="btn-secondary">
                    Reset
                </button>
            </div>

        </form>

        <p id="formStatus"></p>

    </div>

</section>

<footer>
    <p>
        &copy; 2026 Prateek Jadaun. All Rights Reserved.
    </p>
</footer>

<script>
    document.getElementById("contactForm").addEventListener("submit", function(e) {

        e.preventDefault();

        let name = document.getElementById("name").value;

        document.getElementById("formStatus").textContent =
            "Thanks, " + name + "! Your message has been sent.";

        this.reset();
    });
</script>

</body>
</html>
