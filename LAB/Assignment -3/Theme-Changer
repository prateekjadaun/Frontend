<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Theme Changer</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: white;
            color: black;
            text-align: center;
            padding-top: 100px;
            transition: 0.3s;
        }

        .container {
            padding: 30px;
        }

        button {
            padding: 12px 20px;
            margin: 10px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
        }

        .light {
            background-color: #eeeeee;
            color: black;
        }

        .dark {
            background-color: #333333;
            color: white;
        }

    </style>
</head>

<body>

    <div class="container">
        <h1>Color Theme Changer</h1>

        <p>Click on a button to change the theme.</p>

        <button class="light" onclick="changeTheme('light')">
            Light
        </button>

        <button class="dark" onclick="changeTheme('dark')">
            Dark
        </button>

    </div>

    <script>
        function changeTheme(theme) {

            if (theme === "light") {
                document.body.style.backgroundColor = "white";
                document.body.style.color = "black";
            }
            else if (theme === "dark") {
                document.body.style.backgroundColor = "#222222";
                document.body.style.color = "white";
            }

        }
    </script>

</body>
</html>
